# 服务器端口
PORT=5000
# 服务器主机地址
HOST=your-domain.com
# 数据库连接
# 开发环境使用本地MongoDB
MONGODB_URI=mongodb://localhost:27017/workdiary
# 生产环境使用Docker容器中的MongoDB
# MONGODB_URI=mongodb://admin:your-secure-password@mongodb:27017/workdiary?authSource=admin

# JWT密钥 - 请修改为安全的随机字符串
JWT_SECRET=your-secret-key-here

# API密钥加密密钥 - 请修改为32位安全的随机字符串
ENCRYPTION_KEY=your-encryption-key-32-chars!!

# 运行环境
NODE_ENV=development
# 全局LLM配置使用外部LLM服务
LLM_TYPE=external

# 本地LLM配置
# 是否使用本地LLM (true/false)
USE_LOCAL_LLM=false

# 本地LLM API地址 (如使用Ollama)
LOCAL_LLM_API_URL=http://localhost:11434/api/generate

# 本地LLM模型名称
LOCAL_LLM_MODEL=llama3

# 本地LLM请求超时时间(毫秒)
LOCAL_LLM_TIMEOUT=60000

# 本地LLM温度参数 (0.0-1.0)
LOCAL_LLM_TEMPERATURE=0.7

# 会话密钥 - 请修改为安全的随机字符串
SESSION_SECRET=your-session-secret-key-here

# CORS允许的源地址
# 开发环境
CORS_ORIGIN=http://localhost:13000
# 生产环境示例
# CORS_ORIGIN=http://your-domain.com

# PostgreSQL 向量数据库配置 (用于 RAG)
PG_HOST=localhost
PG_PORT=15432
PG_DATABASE=workdiary_vectors
PG_USER=postgres
PG_PASSWORD=workdiary123
# 向量维度 (Qwen3-Embedding-8B = 4096)
VECTOR_DIM=4096