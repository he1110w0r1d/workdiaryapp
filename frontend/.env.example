# 后端API地址
# 开发环境 - 使用本地后端
# REACT_APP_API_URL=http://localhost:5000/api
# 生产环境示例 - 请修改为实际的服务器地址
# REACT_APP_API_URL=http://your-server-ip:5000/api
# REACT_APP_API_URL=http://your-domain.com/api

# 网络配置
# 前端服务绑定的主机地址
# 开发环境可以使用localhost
HOST=localhost
# 如需局域网访问，请设置为实际IP地址
# HOST=192.168.1.100

# 前端服务端口
PORT=3000

# 天气API配置
# 和风天气API Key (免费版，需要注册 https://dev.qweather.com/)
# 请注册并替换为您自己的API密钥
REACT_APP_QWEATHER_KEY=your-qweather-api-key-here

# OpenWeatherMap API Key (免费版，需要注册 https://openweathermap.org/api)
# 请注册并替换为您自己的API密钥
REACT_APP_OPENWEATHER_KEY=your-openweather-api-key-here

# 是否使用模拟天气数据 (true/false)
# 设置为false将尝试使用真实API，如果API调用失败则回退到模拟数据
# 如果没有配置API密钥，建议设置为true
REACT_APP_USE_MOCK_WEATHER=true