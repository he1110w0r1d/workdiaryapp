# 后端服务器配置
PORT=5000
HOST=0.0.0.0

# 数据库配置
MONGODB_URI=mongodb://localhost:27017/workdiary

# JWT密钥
JWT_SECRET=your_jwt_secret_key_here

# 前端配置
REACT_APP_API_URL=http://localhost:5000/api

# LLM配置
USE_LOCAL_LLM=false
LOCAL_LLM_URL=http://localhost:11434/api/generate
LOCAL_LLM_TIMEOUT=600000
LOCAL_LLM_TEMPERATURE=0.7

# 外部LLM配置
EXTERNAL_LLM_PROVIDER=openai
EXTERNAL_LLM_API_KEY=your_api_key_here
EXTERNAL_LLM_API_URL=https://api.openai.com/v1/chat/completions
EXTERNAL_LLM_TIMEOUT=600000
EXTERNAL_LLM_TEMPERATURE=0.7
EXTERNAL_LLM_MAX_TOKENS=8000

# 文件上传配置
MAX_FILE_SIZE=52428800